# Copy this file to "keystore.properties" (same directory, project root) and fill in your
# real values. That file is git-ignored and must NEVER be committed.
#
# Generate a release keystore first, e.g.:
#   keytool -genkey -v -keystore streakwall-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias streakwall
#
# storeFile is resolved relative to the project root.
storeFile=../streakwall-release.jks
storePassword=CHANGE_ME
keyAlias=streakwall
keyPassword=CHANGE_ME
