<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/streakwall_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/streakwall_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
